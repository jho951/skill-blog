<?xml version="1.0" encoding="utf-8"?>
<skin>
    <information>
        <name>해학</name>
        <version>1.0.0</version>
        <description>이장호의 블로그입니다.</description>
        <license>MIT License</license>
        <page>https://skilblog.n-e.kr</page>
        <author>
            <name>이장호</name>
            <email>jho951@naver.com</email>
            <page>https://skilblog.n-e.kr</page>
        </author>
    </information>

    <setting>
        <defaultView>expanded</defaultView>
    </setting>

    <extra_files>
        <file>skin.html</file>
        <file>style.css</file>
        <file>head.html</file>
        <file>images/sys-core.js</file>
        <file>images/ad-guard.js</file>
        <file>images/blog-ui.js</file>
        <file>images/article-utils.js</file>
        <file>images/home-craft.js</file>
        <file>images/theme.js</file>
        <file>images/icon-github.svg</file>
        <file>images/icon-discord.svg</file>
        <file>images/icon-email.svg</file>
        <file>images/icon-rss.svg</file>
        <file>images/icon-medal.svg</file>
        <file>images/icon-award.svg</file>
        <file>images/icon-trophy.svg</file>
        <file>images/icon-microphone.svg</file>
        <file>images/icon-search.svg</file>
        <file>images/icon-comment.svg</file>
        <file>images/cat-hero-cs.svg</file>
        <file>images/cat-hero-dev.svg</file>
        <file>images/cat-hero-eng.svg</file>
        <file>images/cat-hero-ts.svg</file>
        <file>images/cat-sub-network.svg</file>
        <file>images/cat-sub-os.svg</file>
        <file>images/cat-sub-algo.svg</file>
        <file>images/cat-sub-ds.svg</file>
        <file>images/cat-sub-lang.svg</file>
        <file>images/cat-sub-framework.svg</file>
        <file>images/cat-sub-infra.svg</file>
        <file>images/cat-sub-db.svg</file>
        <file>images/cat-sub-tool.svg</file>
        <file>images/cat-sub-dp.svg</file>
        <file>images/cat-sub-test.svg</file>
        <file>images/cat-sub-retro.svg</file>
        <file>images/cat-sub-perf.svg</file>
        <file>images/default-tech-blog-cover.png</file>
    </extra_files>

    <variables>
        <variable>
            <name>viewType</name>
            <label><![CDATA[ 글 목록 스타일 ]]></label>
            <type>select</type>
            <default>list</default>
            <options>
                <option value="list"><![CDATA[ 리스트형 ]]></option>
                <option value="card"><![CDATA[ 카드형 ]]></option>
            </options>
        </variable>

        <variable>
            <name>pointColor</name>
            <label><![CDATA[ 포인트 컬러 ]]></label>
            <type>color</type>
            <default>#333333</default>
        </variable>

        <variable>
            <name>showSidebar</name>
            <label><![CDATA[ 사이드바 노출 ]]></label>
            <type>bool</type>
            <default>true</default>
        </variable>
    </variables>
</skin>
